{
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-06-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "local": {
      "vars": {
        "WEBAUTHN_RP_ID": "karasu256.com",
        "WEBAUTHN_RP_NAME": "Karasu Lab",
        "WEBAUTHN_EXPECTED_ORIGINS": "https://local-accounts.karasu256.com,https://local-auth.karasu256.com",
        "TRUSTED_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004,https://local.karasu256.com,https://local-accounts.karasu256.com,https://local-qr.karasu256.com,https://local-auth.karasu256.com"
      }
    },
    "preview": {
      "name": "accounts-karasu256-com",
