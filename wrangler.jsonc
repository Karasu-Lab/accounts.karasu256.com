{
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-06-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "preview": {
      "name": "accounts-karasu256-com",
      "vars": {
        "API_URL": "https://dev-api.karasu256.com",
        "APP_ENV": "preview",
        "ROOT_APP_URL": "https://dev.karasu256.com",
        "AUTH_URL": "https://dev-auth.karasu256.com",
        "AUTH_API_URL": "https://dev-api-auth.karasu256.com",
        "FEATURE_FLAGS_API_URL": "https://dev-flags.karasu256.com",
        "FEATURE_FLAGS_ORIGIN": "https://dev.accounts.karasu256.com",
        "FIREBASE_APP_ID": "karasu-lab-application"
      }
    }
  },
  "main": ".open-next/worker.js",
  "name": "accounts-karasu256-com",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "previews": {
    "vars": {
      "API_URL": "https://dev-api.karasu256.com",
      "APP_ENV": "preview",
      "ROOT_APP_URL": "https://dev.karasu256.com",
      "AUTH_URL": "https://dev-auth.karasu256.com",
      "AUTH_API_URL": "https://dev-api-auth.karasu256.com",
      "FEATURE_FLAGS_API_URL": "https://dev-flags.karasu256.com",
      "FEATURE_FLAGS_ORIGIN": "https://dev.accounts.karasu256.com",
      "FIREBASE_APP_ID": "karasu-lab-application"
    }
  },
  "vars": {
    "API_URL": "https://api.karasu256.com",
    "APP_ENV": "production",
    "ROOT_APP_URL": "https://karasu256.com",
    "AUTH_URL": "https://auth.karasu256.com",
    "AUTH_API_URL": "https://api-auth.karasu256.com",
    "FEATURE_FLAGS_API_URL": "https://flags.karasu256.com",
    "FEATURE_FLAGS_ORIGIN": "https://accounts.karasu256.com",
    "FIREBASE_APP_ID": "karasu-lab-application"
  }
}