        "WEBAUTHN_RP_ID": "karasu256.com",
        "WEBAUTHN_RP_NAME": "Karasu Lab",
        "WEBAUTHN_EXPECTED_ORIGINS": "https://dev-accounts.karasu256.com,https://dev-auth.karasu256.com,https://dev.karasu256.com",
        "TRUSTED_ORIGINS": "https://dev-accounts.karasu256.com,https://*.dev-accounts.karasu256.com,https://dev-auth.karasu256.com,https://dev.karasu256.com,https://dev-qr.karasu256.com",
        "GOOGLE_CLIENT_ID": "291377837692-haa4bsiure8qm70ionnaamb356qf6uca.apps.googleusercontent.com",
        "GITHUB_CLIENT_ID": "Iv23li7uADcoFUaks9lE",
        "MICROSOFT_CLIENT_ID": "3f583452-5b65-49a0-8df6-99264d2d876f"
      }
