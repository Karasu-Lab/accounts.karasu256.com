# Server-only URL of the image-api Worker, used to upload the profile icon
CDN_URL=

# Server-only URL of api.karasu256.com, which owns the permission catalog and API key grants
API_URL=
# Must match api.karasu256.com's and api-auth.karasu256.com's INTERNAL_API_SECRET, since permission grants and API key issuance are service-to-service calls
INTERNAL_API_SECRET=

# URL of auth.karasu256.com, which hosts the sign-in page
AUTH_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, sign-in API, passkeys, OAuth)
AUTH_API_URL=

FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# This app's identity toward api.karasu256.com: the app ID and the
# Ed25519 private key (base64-encoded PKCS#8) whose public half the API
# registers. Internal calls are signed with it; nothing else proves
# this app. Firebase access itself is proxied by the API, so no
# Firebase Admin credentials live here.
APP_ID=
APP_PRIVATE_KEY=

# Full origin URL of the main karasu256.com app for this environment (e.g.
# https://karasu256.com in production, http://localhost:3000 in local dev),
# used verbatim for the "back to app" link in settings. Required — the
# settings page fails to render if unset.
ROOT_APP_URL=


# Vercel Feature Flags
FLAGS_SECRET=
