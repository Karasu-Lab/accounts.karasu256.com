# URL of the main karasu256.com app (used for the terms of service link)
NEXT_PUBLIC_APP_URL=

# Server-only URL of the image-api Worker, used to upload the profile icon
CDN_URL=

# Server-only URL of api.karasu256.com, which owns the permission catalog and API key grants
API_URL=
# Must match api.karasu256.com's INTERNAL_API_SECRET, since permission grants are service-to-service calls
INTERNAL_API_SECRET=

# Used by the Neon Auth bridge (see packages/db/src/neon-auth.ts)
AUTH_SECRET=

# better-auth — hosts social sign-in and the OAuth/OIDC authorization server.
# Also derives (via HKDF) the key that encrypts Firebase session cookies
# stored server-side for multi-account switching (see
# src/lib/auth/firebase-cookie-crypto.ts).
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side only — never expose to the client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# WebAuthn (server-side only)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_EXPECTED_ORIGIN=

# Cross-subdomain session sharing (optional)
# When set, the session cookie Domain is scoped to .{BASE_DOMAIN} so it is
# shared across all subdomains (e.g. app.example.com, accounts.example.com).
# Leave empty for localhost / single-domain deployments.
BASE_DOMAIN=

# Full origin URL of the main karasu256.com app for this environment (e.g.
# https://karasu256.com in production, http://localhost:3000 in local dev),
# used verbatim for the "back to app" link in settings. Required — the
# settings page fails to render if unset.
ROOT_APP_URL=

# Resend — used to send password-reset emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostgreSQL — used for password-reset tokens
DATABASE_URL=

# Third-party OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Neon Auth — user data layer (sign-in via Firebase, custom data via Neon Auth)
# Retrieve NEON_AUTH_BASE_URL and NEON_AUTH_JWKS_URL from: neonctl neon-auth status
# Generate NEON_AUTH_COOKIE_SECRET with: openssl rand -base64 32  (must be 32+ chars)
# Generate NEON_AUTH_BRIDGE_SECRET with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BRIDGE_SECRET=

# Vercel Feature Flags
FLAGS_SECRET=