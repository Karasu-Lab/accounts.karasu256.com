# Same names better-auth reads on api-auth.karasu256.com
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
MICROSOFT_CLIENT_ID=

CDN_URL=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

API_URL=
# Must match INTERNAL_API_SECRET of api.karasu256.com and api-auth.karasu256.com
INTERNAL_API_SECRET=

# APP_PRIVATE_KEY is a base64-encoded PKCS#8 Ed25519 key; api.karasu256.com registers its public half
APP_ID=
APP_PRIVATE_KEY=

AUTH_URL=
AUTH_API_URL=

MC_AUTH_URL=
MC_AUTH_ADDRESS=

# Required: the settings page fails to render if unset
ROOT_APP_URL=

MCP_OAUTH_CLIENT_ID=

FEATURE_FLAGS_API_URL=
# The flags API only accepts karasu256.com origins
FEATURE_FLAGS_ORIGIN=
