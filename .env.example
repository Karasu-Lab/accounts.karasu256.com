# Public OAuth client ids of the social providers, under the same names
# better-auth reads on api-auth.karasu256.com. They are exposed through the
# client config and decide which providers the linking page offers.
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Server-only URL of the image-api Worker, used to upload the profile icon
CDN_URL=

# S3-compatible object storage behind the CDN, used to presign direct profile icon uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Server-only URL of api.karasu256.com, which owns the permission catalog and API key grants
API_URL=
# Must match api.karasu256.com's and api-auth.karasu256.com's INTERNAL_API_SECRET, since permission grants and API key issuance are service-to-service calls
INTERNAL_API_SECRET=

# This app's identity toward api.karasu256.com's internal user endpoints:
# the app ID and the Ed25519 private key (base64-encoded PKCS#8) whose
# public half the API registers. Each internal call is issued as this
# app's own short-lived token signed with it, alongside the signed-in
# user's better-auth session token. Firebase access itself is proxied
# by the API, so no Firebase Admin credentials live here.
APP_ID=
APP_PRIVATE_KEY=

# URL of auth.karasu256.com, which hosts the sign-in page
AUTH_URL=

# URL of api-auth.karasu256.com, which hosts better-auth (sessions, sign-in API, passkeys, OAuth)
AUTH_API_URL=


# Full origin URL of the main karasu256.com app for this environment (e.g.
# https://karasu256.com in production, http://localhost:3000 in local dev),
# used verbatim for the "back to app" link in settings. Required — the
# settings page fails to render if unset.
ROOT_APP_URL=


MCP_OAUTH_CLIENT_ID=

# URL of flags.karasu256.com (dev-flags.karasu256.com for previews), which serves the feature flags
FEATURE_FLAGS_API_URL=
# Public origin of this app, sent as the Origin header of server-side feature flag requests
# (the flags API only accepts karasu256.com hosts)
FEATURE_FLAGS_ORIGIN=
